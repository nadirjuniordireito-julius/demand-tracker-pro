# ==============================================
# Variáveis de Ambiente - GPD Frontend
# ==============================================
# Copie este arquivo para .env.local e configure os valores

# URL base da API backend (Java Spring Boot)
# Em desenvolvimento local, geralmente é http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api

# TED Health Map: usa API real GET /api/ted/{id}/health (mock removido)

# ==============================================
# Instruções:
# ==============================================
# 1. Copie este arquivo: cp .env.example .env.local
# 2. Configure VITE_API_URL com a URL do seu backend
# 3. Execute: npm run dev
#
# Nota: O sistema possui modo MOCK ativo por padrão
# no authService.ts. Para usar a API real, altere
# MOCK_MODE para false no arquivo.
# ==============================================
